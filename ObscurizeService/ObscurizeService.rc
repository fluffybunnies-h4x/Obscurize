// ============================================================
//  ObscurizeService.rc  –  Resource definitions
//
//  The Agent DLLs are embedded as RCDATA resources so the
//  service EXE is fully self-contained.
//
//  Build order:
//    1.  Build ObscurizeAgent-x86.dll  →  output/ObscurizeAgent32.dll
//    2.  Build ObscurizeAgent-x64.dll  →  output/ObscurizeAgent64.dll
//    3.  Build ObscurizeService.exe    (this RC links the DLLs in)
//
//  Resource IDs match IDR_AGENT_DLL32 / IDR_AGENT_DLL64
//  defined in ServiceMain.h.
// ============================================================

#include <Windows.h>
#include "ServiceMain.h"

// ── Version information ────────────────────────────────────────

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,8,6,0
PRODUCTVERSION  1,8,6,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Null-Sec\0"
            VALUE "FileDescription",  "Obscurize Deception Service\0"
            VALUE "FileVersion",      "1.8.6.0\0"
            VALUE "InternalName",     "ObscurizeService\0"
            VALUE "LegalCopyright",   "Copyright \251 2026 Null-Sec\0"
            VALUE "OriginalFilename", "ObscurizeService.exe\0"
            VALUE "ProductName",      "Obscurize\0"
            VALUE "ProductVersion",   "1.8.6\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END

// ── Embedded Agent DLLs ───────────────────────────────────────

// 32-bit Agent DLL
IDR_AGENT_DLL32  RCDATA  "..\\output\\ObscurizeAgent32.dll"

// 64-bit Agent DLL
IDR_AGENT_DLL64  RCDATA  "..\\output\\ObscurizeAgent64.dll"
