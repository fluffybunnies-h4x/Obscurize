# Visual Studio IDE state - not source code
.vs/

# Build outputs
*.obj
*.pdb
*.iobj
*.ipdb
*.exp
*.lib
*.log
*.tlog
*.res
*.cache

# Exception: Detours pre-built static libs are linker dependencies, not generated artifacts.
# These must be tracked explicitly because the *.lib rule above would otherwise exclude them.
# The **/x64/ and **/x86/ rules below are scoped to project intermediate dirs only (not SlnBin)
# so that this exception does not fight directory-level exclusions.
!r77-rootkit/r77-rootkit-master/SlnBin/x64/detours.lib
!r77-rootkit/r77-rootkit-master/SlnBin/x86/detours.lib

# MSBuild intermediate directories - scoped to project folders to avoid matching SlnBin
**/Release/
**/Debug/
ObscurizeAgent/x64/
ObscurizeAgent/x86/
ObscurizeAgent/Obscuriz*/
ObscurizeService/x64/
ObscurizeService/ObscurizeService/

# .NET build output
**/bin/
**/obj/

# Agent DLL staging dir. The service .rc embeds ..\output\ObscurizeAgent{32,64}.dll
# as RCDATA at build time, so these DLLs are *generated build outputs* - they must
# be produced by a clean build of the Agent projects, never tracked in the repo.
# Committing them lets an incremental / Service-only build embed stale (or tampered)
# bytes into the payload the SYSTEM service injects into every process. The .gitkeep
# preserves the directory on a fresh clone so the build/.rc paths resolve.
output/*.dll
output/*.exe
!output/.gitkeep

# Stale per-project output dirs (service now outputs to root output\ only)
ObscurizeService/output/

# Per-deployment runtime files - generated by ObscurizeInitializer.ps1
# Contains the randomized service name chosen at install time
service.cfg

# User-specific files
*.user
*.suo
