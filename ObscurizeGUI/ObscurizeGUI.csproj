<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      net48 targets the .NET Framework 4.8 runtime which ships with
      Windows 10/11 — no runtime installation required on end-user machines.
      WinForms is enabled via UseWindowsForms; no XAML / WPF dependency.
    -->
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>10</LangVersion>
    <AssemblyName>ObscurizeGUI</AssemblyName>
    <RootNamespace>Obscurize</RootNamespace>
    <Version>1.9.0</Version>
    <AssemblyVersion>1.9.0.0</AssemblyVersion>
    <FileVersion>1.9.0.0</FileVersion>
    <Company>Null-Sec</Company>
    <Product>Obscurize</Product>
    <Copyright>Copyright © 2026 Null-Sec</Copyright>
    <ApplicationIcon>..\ObscurizeShared\Obscurize.ico</ApplicationIcon>
    <!-- Require elevation – the GUI must write to HKLM and talk to LocalSystem -->
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <!--
      Do not emit a PDB. The .NET compiler stamps the absolute build-machine
      path to the PDB into the EXE's debug directory (e.g.
      C:\Users\<name>\...\obj\Release\net48\ObscurizeGUI.pdb), which leaks the
      developer's username and directory layout to anyone who runs `strings`
      on a distributed binary. The C/C++ projects already produce no PDB in
      Release; this brings the managed build in line.
    -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- Deterministic output: no absolute source paths in the assembly. -->
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=.</PathMap>
  </PropertyGroup>

  <!-- Link the shared constants file directly rather than a separate assembly -->
  <ItemGroup>
    <Compile Include="..\ObscurizeShared\ObscurizeConst.cs" Link="ObscurizeConst.cs" />
  </ItemGroup>

  <!-- WMI lookup of the running service's randomized name (ServiceLocator.cs) -->
  <ItemGroup>
    <Reference Include="System.Management" />
  </ItemGroup>

</Project>
